#!/bin/bash -l
# Set before use: REPO (this repository), LISTS (folder of <sample>-merged-cafs.txt), DATA, OUT; and -A to your allocation.
#PBS -A <project>::<suballocation>
#PBS -q debug
#PBS -l select=1
#PBS -l walltime=00:58:00
#PBS -l filesystems=flare
#PBS -N tables-a
#PBS -j oe
#PBS -o $OUT/tables-a.out
source $HOME/env.sh   # module load frameworks; pip --user uproot xgboost
B=$REPO/tables/build_tables.py
L=$LISTS
O=$OUT
python $B aurora-r2-bnb $O --list $L/bnb-merged-cafs.txt --nproc 100 --tag all
python $B aurora-r2-ncdr $O --list $L/ncdr-merged-cafs.txt --nproc 100 --tag all
ls $DATA/fg1-beam-off-train/*/*.root > $O/beamoff-train-files.txt
python $B fg1-beam-off-train $O --list $O/beamoff-train-files.txt --nproc 100 --tag all
echo DONE
