#!/bin/bash -l
# Set before use: REPO (this repository), LISTS (folder of <sample>-merged-cafs.txt), DATA, OUT; and -A to your allocation.
#PBS -A <project>::<suballocation>
#PBS -q debug
#PBS -l select=1
#PBS -l walltime=00:58:00
#PBS -l filesystems=flare
#PBS -N tables-b
#PBS -j oe
#PBS -o $OUT/tables-b.out
source $HOME/env.sh   # module load frameworks; pip --user uproot xgboost
B=$REPO/tables/build_tables.py
L=$LISTS
O=$OUT
for s in 0 1 2; do python $B aurora-r2-nuecc $O --list $L/nuecc-merged-cafs.txt --slice $((s*10000)):$(((s+1)*10000)) --nproc 100 --tag s$s; done
echo DONE
